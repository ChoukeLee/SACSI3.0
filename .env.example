NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI workbench intent classifier (optional; fixed rule queries work without it) ──
# AI_QUERY_CLASSIFIER_ENABLED=true
# AI_QUERY_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# Alternative OpenAI provider:
# OPENAI_API_KEY=
# OPENAI_QUERY_MODEL=

# ── Error monitoring (Sentry, optional) ──
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── OCR providers (optional) ──
# OCR_PROVIDER=deepseek-vision-exp  # experimental; keep disabled until receipt benchmark passes
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# OCR_PROVIDER=qwen-vl-plus   # or openai-vision, mock (default)
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VISION_MODEL=qwen-vl-plus
# OCR_PROVIDER=glm-4v          # 智谱 ChatGLM Vision
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_VISION_MODEL=glm-4v
