NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI workbench intent classifier (optional; fixed rule queries work without it) ──
# AI_QUERY_CLASSIFIER_ENABLED=true
# AI_QUERY_PROVIDER=deepseek
# AI_QUERY_PLANNER_SHADOW_ENABLED=true
# AI_QUERY_PLANNER_PROVIDER=deepseek
# AI_QUERY_PLANNER_MODEL=deepseek-v4-flash
# AI_QUERY_PLANNER_THINKING_ENABLED=false
# Guarded rollout: only one compatible, high-confidence read call may replace legacy.
# Keep false until the live evaluation gate passes; multi-tool plans still fall back.
# AI_QUERY_PLANNER_SINGLE_TOOL_ENABLED=false
# Local/CI opt-in evaluation (synthetic questions only; consumes model requests):
# AI_QUERY_PLANNER_LIVE_EVAL=false
# AI_QUERY_PLANNER_LIVE_EVAL_MIN_PASS_RATE=0.8
# Optional prose synthesis after a successful V2 read. Receives metrics and
# evidence only; raw result rows and customer/contract records are excluded.
# AI_QUERY_RESULT_SYNTHESIS_ENABLED=false
# AI_QUERY_RESULT_SYNTHESIS_PROVIDER=deepseek
# AI_QUERY_RESULT_SYNTHESIS_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# Alternative OpenAI provider:
# OPENAI_API_KEY=
# OPENAI_QUERY_MODEL=

# ── Receipt draft revision fallback (optional; local rules remain first) ──
# Enabled by default when the selected provider key exists; set false to disable.
# AI_RECEIPT_REVISION_MODEL_ENABLED=true
# AI_RECEIPT_REVISION_PROVIDER=deepseek  # or openai; defaults to AI_QUERY_PROVIDER
# AI_RECEIPT_REVISION_MODEL=             # defaults to the provider's query model

# ── Error monitoring (Sentry, optional) ──
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── OCR providers (optional) ──
# If DEEPSEEK_API_KEY exists, DeepSeek Vision is the default OCR provider.
# OCR_PROVIDER=deepseek-vision-exp
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# OCR_PROVIDER=qwen-vl-plus   # or glm-4v, openai-vision, mock (default)
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VISION_MODEL=qwen-vl-plus
# OCR_PROVIDER=glm-4v          # 智谱 ChatGLM Vision
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GLM_VISION_MODEL=glm-4v

# Server-only preview integrity key: 32 random bytes encoded as 64 hex characters.
# Separate from Supabase/Auth keys. Never use a NEXT_PUBLIC_ prefix or commit a real key.
# Missing key disables screenshot preview issuance. Preview is NOT approval.
# SACSI_OPERATOR_PREVIEW_SECRET=
# Keep disabled until BOTH payment-integrity and confirmation migrations and
# real-account acceptance have passed. Local tests set this explicitly.
# SACSI_OPERATOR_CONFIRMATIONS_ENABLED=false
# Optional exact browser origin behind a proxy (no trailing slash); never a wildcard.
# SACSI_OPERATOR_PUBLIC_ORIGIN=https://your-reviewed-app-domain
