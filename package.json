{
  "name": "sacis-real-estate-system",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:daily-rental-rules": "node scripts/check-daily-rental-rules.mjs",
    "validate": "npm run lint && npm run format:check && npm run check:daily-rental-rules && npm run typecheck && npm run build",
    "format:check": "node scripts/check-engineering-format.mjs",
    "format:write": "node scripts/check-engineering-format.mjs --write",
    "test:db-rebuild": "vitest run --config vitest.postgres.config.ts tests/application-rebuild.native.ts",
    "test": "vitest run",
    "test:operator-payment": "vitest run tests/operator-payment-database.test.ts tests/operator-payment-http-database.test.ts tests/operator-payment-route-behavior.test.ts src/features/business-actions/operator-payment-verification.test.ts",
    "test:operator-concurrency": "vitest run --config vitest.postgres.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^22.10.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/parser": "8.59.3",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.26",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "^29.1.1",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "4.1.11"
  }
}
